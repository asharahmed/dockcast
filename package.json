{
  "name": "dockcast",
  "private": true,
  "description": "Bike-share station availability forecasts for the time you will actually arrive",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/asharahmed/dockcast.git"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "tsx --env-file-if-exists=.env packages/db/bin/migrate.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
