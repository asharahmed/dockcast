# --- database ---
POSTGRES_PASSWORD=change-me                     # used by the db container
DATABASE_URL=postgres://postgres:change-me@db:5432/dockcast    # dev: postgres://postgres:dockcast@localhost:5432/dockcast
DATABASE_URL_TEST=                              # dev/CI only: postgres://postgres:dockcast@localhost:5433/dockcast_test

# --- web / api ---
DOMAIN=dockcast.aahmed.ca                       # bare domain; also the default Caddy site address
SITE_ADDRESS=                                    # optional: full Caddy site address override, e.g.
                                                  # http://localhost for a local smoke-test stack (an
                                                  # explicit http:// scheme disables automatic HTTPS,
                                                  # which a bare `localhost` address does NOT do).
                                                  # Unset in real deployments -- defaults to $DOMAIN.
PUBLIC_BASE_URL=https://dockcast.aahmed.ca      # used in push URLs / emails
PORT=3000
SESSION_SECRET=                                 # openssl rand -base64 48   (>= 32 bytes)
VAPID_PUBLIC_KEY=                               # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ashar@aahmed.ca
LOG_LEVEL=info

# --- collector ---
POLL_INTERVAL_MS=60000
INFO_INTERVAL_MS=3600000
WEATHER_INTERVAL_MS=1800000
CITIES=                                          # optional comma-separated slug filter
HEALTHCHECKS_COLLECTOR_URL=                      # https://hc-ping.com/<uuid>  (optional)
                                                  # NOTE: leaving this literally blank makes the
                                                  # collector crash-loop -- apps/collector/src/config.ts
                                                  # validates it with zod's `.url().optional()`, which
                                                  # rejects "" as an invalid URL (only an *absent* var
                                                  # passes). Either fill in a real hc-ping.com URL or
                                                  # comment out the whole line. See WP-11 final report.

# --- workers ---
HEALTHCHECKS_TRAINER_URL=                        # optional
PREDICT_INTERVAL_SEC=300
TRIPS_CACHE_DIR=/data/cache
GIT_SHA=                                         # injected by deploy (image label); optional
TZ=UTC                                           # worker-train overrides to America/Toronto in compose

# --- misc ---
NODE_ENV=production
TRUST_PROXY=1                                    # api: express 'trust proxy' hops (Caddy)
VITE_REPO_URL=https://github.com/<owner>/dockcast # web build-time: link to repo/docs from the UI

# --- deploy (infra/docker-compose.yml) ---
GHCR_OWNER=                                      # GitHub owner, lowercase, e.g. ashar-aahmed --
                                                  # used to build the ghcr.io/$GHCR_OWNER/dockcast-*
                                                  # image references. Not needed for a plain
                                                  # `docker compose build` (only for `pull`/deploy).
IMAGE_TAG=latest                                 # image tag to pull/run; deploy.yml also pushes the
                                                  # commit SHA as a tag if you want to pin a rollout.
ENV_FILE=.env                                    # which file (relative to infra/) each service's
                                                  # `env_file:` loads. Only override for a second,
                                                  # side-by-side compose project (e.g. a local smoke
                                                  # test with `--env-file infra/.env.local-smoke`,
                                                  # which should also set ENV_FILE=.env.local-smoke
                                                  # inside itself so both mechanisms agree).
HEALTHCHECKS_BACKUP_URL=                         # https://hc-ping.com/<uuid> pinged by
                                                  # infra/scripts/backup.sh after a successful dump
                                                  # (optional; read from this file by the script
                                                  # itself, not by any compose service)
