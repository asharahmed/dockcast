# Certificates via ACME DNS-01 (Cloudflare) so a host nothing external can
# reach — the Tailscale-only proving deployment — still gets real certs.
# Harmless when the token is unset: issuance only triggers for https site
# addresses, and http-only deployments never create one.
{
	cert_issuer acme {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# The container's resolver (Docker Desktop on Windows) can't reliably see
		# public DNS, so Caddy's local propagation self-check times out even though
		# the challenge TXT record is created fine. Skip the self-check — the CA
		# validates against the zone's authoritative servers — and use a public
		# resolver for any lookups the solver still makes.
		resolvers 1.1.1.1
		propagation_timeout -1
		# With the self-check skipped, validation raced Cloudflare's authoritative
		# propagation and the CA saw "no TXT record" ~1s after creation (verified by
		# watching the record appear in the zone mid-attempt). Fixed wait instead.
		propagation_delay 15s
	}
}

# SITE_ADDRESS may list several addresses, e.g. "dockcast.aahmed.ca, http://:80"
# to serve the TLS domain and keep plain-http (IP-based) access alive.
{$SITE_ADDRESS} {
	encode zstd gzip
	# HSTS only over TLS: browsers ignore the header on plain http anyway, and the
	# Tailscale proving deployment serves http on {$SITE_ADDRESS} :80.
	@secure protocol https
	header @secure Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		-Server
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy api:3000 {
		header_up X-Request-Start {time.now.unix_ms}
	}
	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
		format json
	}
}
