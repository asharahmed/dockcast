{
  "name": "@dockcast/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
